<?xml version="1.0"?>
<package format="3">
  <name>openmanipulatorlab</name>
  <version>0.1.0</version>
  <description>ROS 2 pick-and-sort demo for the OpenManipulator-X using MoveIt 2.</description>

  <maintainer email="amnaahmad43200@gmail.com">Amna Ahmad</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>moveit_configs_utils</depend>
  <depend>moveit_msgs</depend>
  <depend>moveit_py</depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>shape_msgs</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>open_manipulator_bringup</exec_depend>
  <exec_depend>open_manipulator_moveit_config</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
